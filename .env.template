# Live Great Foundation - Environment Variables Template
# Copy this file to .env and update the values for your deployment
# For Render deployment, set these variables in the Render Dashboard

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================
SECRET_KEY=your-secret-key-here-50-characters-minimum
DEBUG=False
ALLOWED_HOSTS=your-app-name.onrender.com,livegreatfoundation.org,www.livegreatfoundation.org,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=blog.settings

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Supabase PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-host.supabase.com:6543/postgres

# =============================================================================
# EMAIL CONFIGURATION (Gmail SMTP)
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=60
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=Live Great Foundation Technical Team <your-email@gmail.com>

# =============================================================================
# EMAIL NOTIFICATION SETTINGS
# =============================================================================
LGF_ADMIN_EMAIL=info@livegreatfoundation.org
LGF_NOTIFICATION_ENABLED=True

# =============================================================================
# PRODUCTION SECURITY SETTINGS
# =============================================================================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# =============================================================================
# SITE CONFIGURATION
# =============================================================================
SITE_URL=https://your-app-name.onrender.com
SITE_NAME=Live Great Foundation

# =============================================================================
# STATIC FILES CONFIGURATION
# =============================================================================
STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media

# =============================================================================
# RENDER DEPLOYMENT SETTINGS
# =============================================================================
PYTHON_VERSION=3.12.3
PORT=10000
WEB_CONCURRENCY=3

# =============================================================================
# OPTIONAL SETTINGS (Uncomment and configure as needed)
# =============================================================================

# For development/testing (uncomment to override production settings)
# DEBUG=True
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SECURE_SSL_REDIRECT=False

# Sentry for error tracking (uncomment and configure if using Sentry)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Redis for caching (uncomment if using Redis)
# REDIS_URL=redis://localhost:6379/0

# AWS S3 for media files (uncomment if using S3)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# USE_S3=True

# =============================================================================
# INSTRUCTIONS FOR RENDER DEPLOYMENT
# =============================================================================
# 1. Copy this file to .env for local development
# 2. For Render deployment, set these variables in Render Dashboard:
#    - Go to your service → Environment
#    - Add each variable individually
#    - Mark sensitive variables (passwords, keys) as secret
# 3. Update the following values:
#    - SECRET_KEY: Generate a new 50+ character secret key
#    - ALLOWED_HOSTS: Replace with your actual Render domain
#    - DATABASE_URL: Your actual Supabase connection string
#    - EMAIL_HOST_USER: Your Gmail address
#    - EMAIL_HOST_PASSWORD: Your Gmail app-specific password
#    - SITE_URL: Your actual production URL
