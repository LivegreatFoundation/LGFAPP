# Live Great Foundation - Production Environment Variables
# Copy this file to .env and update the values for your deployment

# Django Core Settings
SECRET_KEY=django-insecure-production-key-change-this-to-a-secure-random-string-of-50-characters
DEBUG=False
ALLOWED_HOSTS=your-app-name.onrender.com,livegreatfoundation.org,www.livegreatfoundation.org,localhost,127.0.0.1

# Database Configuration (Supabase PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Email Configuration (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=60
EMAIL_HOST_USER=dedeexpeditions@gmail.com
EMAIL_HOST_PASSWORD=roqu frlt wvof rqxk
DEFAULT_FROM_EMAIL=Live Great Foundation Technical Team <dedeexpeditions@gmail.com>

# Email Notification Settings
LGF_ADMIN_EMAIL=info@livegreatfoundation.org
LGF_NOTIFICATION_ENABLED=True

# Security Settings
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
X_FRAME_OPTIONS=DENY

# Static Files Configuration
STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media

# Application Settings
SITE_URL=https://your-app-name.onrender.com
SITE_NAME=Live Great Foundation

# Render Deployment Settings
PYTHON_VERSION=3.12.3
PORT=10000

# Optional: Sentry for Error Tracking (uncomment and configure if needed)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Optional: Redis for Caching (uncomment if using Redis)
# REDIS_URL=redis://localhost:6379/0

# Optional: AWS S3 for Media Files (uncomment if using S3)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# USE_S3=True
